# The public API base URL — no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# The canonical URL of this Next.js app (used by Better Auth for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth ─ must match DATABASE_URL below (server-side only)
DATABASE_URL=postgresql://daily_logger:daily_logger@localhost:5432/daily_logger
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth  → https://console.cloud.google.com
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
