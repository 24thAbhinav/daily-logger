DATABASE_URL=postgresql+asyncpg://daily_logger:daily_logger@localhost:5432/daily_logger
FRONTEND_URL=http://localhost:3000

# Clerk JWKS URL for verifying session tokens (e.g. from https://<domain>/__clerk/.well-known/jwks.json or Clerk dashboard)
CLERK_JWKS_URL=
# Optional: Pin trusted token issuer(s) (comma-separated if multiple)
CLERK_ISSUER=
# Optional: Pin allowed authorized party origins (defaults to FRONTEND_URL and localhost:3000)
CLERK_AUTHORIZED_PARTIES=
# Optional: Pin expected audience if a custom Clerk JWT template with 'aud' is configured
CLERK_AUDIENCE=
