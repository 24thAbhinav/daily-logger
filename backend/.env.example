DATABASE_URL=postgresql+asyncpg://daily_logger:daily_logger@localhost:5432/daily_logger
FRONTEND_URL=http://localhost:3000
# The URL where Next.js (Better Auth) is running so the backend can verify sessions.
BETTER_AUTH_URL=http://localhost:3000
# Must be identical to frontend BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=replace-with-the-same-long-random-secret
